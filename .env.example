# =============================================================================
# wa-support-ai — Environment Configuration
# =============================================================================

# Server
PORT=3000

# ── OpenAI / LLM ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── WA Channel: Outbound Send API Credentials ──
# Basic Auth required to call POST /wa-channel/send-message
WA_SEND_API_USER=
WA_SEND_API_PASS=

# ── Database (MySQL via TypeORM) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wa_support_ai
