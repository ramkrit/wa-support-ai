# =============================================================================
# wa-support-ai — Environment Configuration
# =============================================================================

# Server
PORT=3000

# ── OpenAI / LLM ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/wa_support_ai

# ── WA Channel: Outbound Send API Credentials ──
# Basic Auth required to call POST /wa-channel/send-message
WA_SEND_API_USER=
WA_SEND_API_PASS=
